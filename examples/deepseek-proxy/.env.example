# Copy to .env and edit:
#   copy .env.example .env

# ========== FreeBuff example (keep your upstream) ==========
# OPENAI_API_BASE=https://model.wangbinjie.top/v1
# OPENAI_API_KEY=freebuff
# LLM_MODEL=deepseek/deepseek-v4-flash
# OPENAI_MODEL_ID=deepseek/deepseek-v4-flash
# UPSTREAM_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36
# Run: .\test-upstream.ps1  (must OK before start-litellm.ps1)

# ========== Upstream: any OpenAI-compatible API ==========
# Base URL including /v1 (examples below)
# IMPORTANT: freebuff / model.wangbinjie.top often returns Cloudflare 502.
# Run .\test-upstream.ps1 after editing .env — must return OK before Agent works.
OPENAI_API_BASE=https://api.deepseek.com/v1
OPENAI_API_KEY=sk-your-api-key-here

# Model id that Claude Code requests (litellm model_name)
LLM_MODEL=deepseek-chat

# Actual model id sent to upstream (default: same as LLM_MODEL)
# OPENAI_MODEL_ID=deepseek-chat

# Optional: separate model for Claude "opus" tier (default: LLM_MODEL)
# LLM_MODEL_OPUS=deepseek-reasoner
# OPENAI_MODEL_ID_OPUS=deepseek-reasoner

# --- Other provider examples ---
# OpenAI:
# OPENAI_API_BASE=https://api.openai.com/v1
# OPENAI_API_KEY=sk-...
# LLM_MODEL=gpt-4o

# Local Ollama (OpenAI-compatible):
# OPENAI_API_BASE=http://127.0.0.1:11434/v1
# OPENAI_API_KEY=ollama
# LLM_MODEL=llama3.2

# One API / custom gateway:
# OPENAI_API_BASE=https://your-host/v1
# OPENAI_API_KEY=your-key
# LLM_MODEL=your-model-id

# Optional: User-Agent sent to upstream (required for some gateways like freebuff)
# UPSTREAM_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36

# ========== Local LiteLLM proxy ==========
PROXY_HOST=127.0.0.1
PROXY_PORT=4000
PROXY_API_KEY=proxy-local

# Optional LiteLLM master key (if set, PROXY_API_KEY must match)
# LITELLM_MASTER_KEY=sk-litellm-local
