# FreeBuff2API local (OpenAI-compatible) — Claude Code needs LiteLLM in front
OPENAI_API_BASE=http://127.0.0.1:8000/v1
OPENAI_API_KEY=freebuff

# Must match freebuff2api /v1/models id (Authorization: Bearer freebuff)
LLM_MODEL=deepseek/deepseek-v4-flash
OPENAI_MODEL_ID=deepseek/deepseek-v4-flash

# Gateway blocks curl/8.0 and OpenAI/Python; use browser UA
UPSTREAM_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36

PROXY_HOST=127.0.0.1
PROXY_PORT=4000
PROXY_API_KEY=proxy-local
