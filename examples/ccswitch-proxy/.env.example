# Copy to .env and edit:
#   copy .env.example .env

# CC Switch local proxy (desktop app must be running with Proxy enabled)
CCSWITCH_BASE_URL=http://127.0.0.1:15721

# Use the same key as the Claude provider in CC Switch.
# For local freebuff2api (Bearer auth), provider should set ANTHROPIC_AUTH_TOKEN=freebuff
# and apiFormat=openai_chat; Base URL http://127.0.0.1:8000 (no trailing /v1).
ANTHROPIC_API_KEY=freebuff
ANTHROPIC_AUTH_TOKEN=freebuff

# Model id Claude Code will request (must be routed in CC Switch)
LLM_MODEL=deepseek/deepseek-v4-flash

# Optional opus-tier model (defaults to LLM_MODEL)
# LLM_MODEL_OPUS=deepseek/deepseek-v4-pro
