# CC Switch local proxy (desktop: Proxy ON; provider freebuff -> http://127.0.0.1:8000)
CCSWITCH_BASE_URL=http://127.0.0.1:15721

# Send the real freebuff key (not PROXY_MANAGED). freebuff2api needs Bearer freebuff;
# CC Switch provider should use ANTHROPIC_AUTH_TOKEN=freebuff for upstream.
ANTHROPIC_API_KEY=freebuff
ANTHROPIC_AUTH_TOKEN=freebuff

# Must match freebuff2api /v1/models
LLM_MODEL=sensenova/deepseek-v4-flash
# LLM_MODEL_OPUS=deepseek/deepseek-v4-pro
